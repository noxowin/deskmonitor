<UserControl x:Class="deskmonitor.PluginManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:local="clr-namespace:deskmonitor">
    <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button x:Name="InstallButton" Content="导入插件…" Click="Install_Click" Margin="0,0,8,8" />
            <Button Content="打开插件目录" Click="OpenFolder_Click" Margin="0,0,0,8" />
        </WrapPanel>
        <TextBlock x:Name="OperationText" DockPanel.Dock="Top" Margin="0,0,0,12"
                   Visibility="Collapsed"
                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBlock x:Name="EmptyText" Text="导入插件，或把 .plugin 文件放入插件目录。"
                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <Grid x:Name="InstalledPlugins" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="PluginList" DisplayMemberPath="Name" SelectionChanged="PluginList_SelectionChanged"
                     AutomationProperties.Name="已安装的插件" />
            <local:TouchDragScrollViewer Grid.Column="1" Margin="18,0,0,0"
                                         Style="{DynamicResource {x:Type ScrollViewer}}"
                                         VerticalScrollBarVisibility="Auto"
                                         IsEnableSmoothManipulating="False" PanningMode="None"
                                         local:ScrollCacheDuringTouch.Enabled="True">
                <local:TouchDragScrollViewer.Physics>
                    <local:SnappyScrollPhysics />
                </local:TouchDragScrollViewer.Physics>
                <StackPanel x:Name="PluginInfo">
                    <TextBlock x:Name="NameText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Margin="0,4,0,12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:ToggleSwitch x:Name="EnabledSwitch" Header="启用插件" Toggled="Enabled_Toggled" />
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,6,0,12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel x:Name="InputPanel" Margin="0,0,0,16">
                        <TextBlock x:Name="InputLabel" FontWeight="SemiBold" />
                        <TextBlock x:Name="InputPathText" TextWrapping="Wrap" Margin="0,3,0,6" />
                        <WrapPanel>
                            <Button Content="选择文件…" Click="ChooseInput_Click" Margin="0,0,8,0" />
                            <Button x:Name="ClearInputButton" Content="清除" Click="ClearInput_Click" />
                        </WrapPanel>
                    </StackPanel>
                    <Button Content="移除插件" Click="Remove_Click" HorizontalAlignment="Left" />
                    <local:PluginReadingsView x:Name="PluginReadings" Visibility="Collapsed" Margin="0,16,0,0" />
                </StackPanel>
            </local:TouchDragScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
