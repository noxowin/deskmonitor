<UserControl x:Class="deskmonitor.PluginReadingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="ReadingVisibility" />
    </UserControl.Resources>
    <ItemsControl x:Name="Readings">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Grid Margin="0,5,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" MaxWidth="125" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Row.Glyph}" FontFamily="Segoe MDL2 Assets"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="{Binding Row.Label}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Row.Detail}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Row.Value}" TextAlignment="Right"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="3" IsChecked="{Binding Shown, Mode=OneWay}"
                              Visibility="{Binding Selectable, Converter={StaticResource ReadingVisibility}}"
                              Click="ShowReading_Click" MinWidth="0" Width="26"
                              Margin="10,0,0,0" VerticalAlignment="Center"
                              ToolTip="在任务栏显示此项"
                              AutomationProperties.Name="{Binding Row.Label, StringFormat='在任务栏显示 {0}'}" />
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
