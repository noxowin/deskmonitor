<UserControl x:Class="deskmonitor.PluginDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:deskmonitor"
             Background="Transparent">
    <StackPanel>
        <DockPanel Margin="0,2,0,12" LastChildFill="True">
            <ContentControl x:Name="PinSlotHost" DockPanel.Dock="Right"
                            VerticalAlignment="Center" Margin="8,0,0,0" />
            <TextBlock x:Name="TitleText" Text="插件" FontSize="22" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <TextBlock x:Name="StatusText" Text="暂无数据" TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <local:TouchDragScrollViewer MaxHeight="380"
                                     Style="{DynamicResource {x:Type ScrollViewer}}"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                     IsEnableSmoothManipulating="False" PanningMode="None"
                                     local:ScrollCacheDuringTouch.Enabled="True">
            <local:TouchDragScrollViewer.Physics>
                <local:SnappyScrollPhysics />
            </local:TouchDragScrollViewer.Physics>
            <local:PluginReadingsView x:Name="Readings" />
        </local:TouchDragScrollViewer>
    </StackPanel>
</UserControl>
